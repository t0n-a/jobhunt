# Copy to .env and fill in. .env is gitignored.
# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=
# Only needed when llm.provider is "openai_compat".
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Free Google AI Studio key (aistudio.google.com/apikey), with llm.provider: openai_compat:
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_API_KEY=<key from aistudio.google.com/apikey>

# Optional: a free key from itjobs.pt/api enables the ITJobs.pt source, which is
# Portugal's largest IT board. Without it that source is skipped entirely.
ITJOBS_API_KEY=

# Optional: push the daily task to Telegram. Create a bot with @BotFather for the
# token, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
