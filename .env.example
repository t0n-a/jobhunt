# Copy to .env and fill in. .env is gitignored.
# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=
# Only needed when llm.provider is "openai_compat".
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Optional: a free key from itjobs.pt/api enables the ITJobs.pt source, which is
# Portugal's largest IT board. Without it that source is skipped entirely.
ITJOBS_API_KEY=
